# ========================================================
#       FINTRACKER PRO - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=8080
APP_ENV=development

# Database Driver: 'postgres' hoặc 'sqlite'
# Mặc định kết nối PostgreSQL. Nếu không thể kết nối, hệ thống sẽ tự động dùng SQLite an toàn.
DB_DRIVER=postgres

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fintracker
DB_SSLMODE=disable

# Chuỗi kết nối đầy đủ (tuỳ chọn ghi đè)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fintracker?sslmode=disable

# SQLite Fallback Data Path
SQLITE_PATH=data/fintracker.db
