# ========================================================
#       FINTRACKER PRO - ENVIRONMENT EXAMPLE TEMPLATE
# ========================================================

# Server Port
PORT=8080
APP_ENV=development

# Database Driver: 'postgres' hoặc 'sqlite'
DB_DRIVER=postgres

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=fintracker
DB_SSLMODE=disable

# SQLite Fallback Data Path
SQLITE_PATH=data/fintracker.db
